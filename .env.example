# Application Environment
APP_ENV=development
DEBUG=true

# Database (PostgreSQL with pgvector for production / SQLite for local zero-dependency testing)
DATABASE_URL=sqlite:///./brandcanon.db
# DATABASE_URL=postgresql://brandcanon:brandcanon_secret@localhost:5432/brandcanon_db

# Redis & Background Workers (Phase 3+)
REDIS_URL=redis://localhost:6379/0

# Security Secrets
JWT_SECRET=brandcanon_super_secret_jwt_key_enterprise_2026_change_in_prod
SESSION_SECRET=brandcanon_session_signing_secret_enterprise_2026

# AI Engine (Phase 4 - Provider Abstraction)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Storage (Phase 2 - Private Object Storage)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=brandcanon-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Service Endpoints
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

